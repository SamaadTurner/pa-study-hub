# Settings for docker compose. Copy this file to .env and fill it in.
# Never commit .env.

# Signs the login tokens. Use at least 32 random characters, for example the
# output of: openssl rand -hex 32
# The backend will not start with this left empty.
JWT_SECRET=

# The database the postgres container creates and the backend connects to
DB_NAME=pa_study_hub
DB_USER=pastudyhub
DB_PASSWORD=change-this-password

# Optional: a free Groq API key (console.groq.com) turns on the AI features.
# Leave it empty to keep them off.
AI_API_KEY=
