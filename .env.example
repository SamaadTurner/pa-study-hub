# ==========================================
# PA Study Hub — Environment Variables (Monolith)
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==========================================

# ---- JWT ----
# Must be at least 256 bits (32+ chars) of random data for HS256
JWT_SECRET=replace-with-a-very-long-random-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRY_MS=900000       # 15 minutes
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---- PostgreSQL (Single Database) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pa_study_hub
DB_USERNAME=pastudyhub
DB_PASSWORD=replace-with-secure-password

# ---- Application ----
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend ----
VITE_API_URL=http://localhost:8080/api/v1

# ---- Logging ----
LOG_LEVEL=INFO
