config.stopBubbling = true

# Marks the getters, builders and so on that Lombok writes with @Generated.
# JaCoCo skips code with that mark, so coverage is counted on hand-written code only.
lombok.addLombokGeneratedAnnotation = true

# Copies @JsonProperty from a field to the getter and setter Lombok writes. Without it,
# Jackson 2.18 and later treat a field like isPublic (getter isPublic()) as two properties
# and write the JSON twice, as "isPublic" and "public".
lombok.copyableAnnotations += com.fasterxml.jackson.annotation.JsonProperty
